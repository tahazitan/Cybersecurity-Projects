<!-- Lab marker rules ONLY. These do not prove malicious activity. -->
<group name="msilblocker_lab,windows,sysmon,">
  <rule id="100201" level="4">
    <field name="win.system.eventID">^1$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)MSILBlockerLab</field>
    <description>LAB: tagged benign process seen in Sysmon</description>
    <group>msilblocker_lab,</group>
  </rule>
  <rule id="100202" level="5">
    <field name="win.system.eventID">^11$</field>
    <field name="win.eventdata.targetFilename" type="pcre2">(?i)MSILBlockerLab</field>
    <description>LAB: tagged benign file creation seen in Sysmon</description>
    <group>msilblocker_lab,</group>
  </rule>
  <rule id="100203" level="7">
    <field name="win.system.eventID">^13$</field>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)MSILBlockerLab</field>
    <description>LAB: tagged benign registry set seen in Sysmon</description>
    <group>msilblocker_lab,</group>
  </rule>
  <rule id="100204" level="10">
    <field name="win.system.eventID">^13$</field>
    <field name="win.eventdata.targetObject" type="pcre2">(?i)\\CurrentVersion\\Run\\MSILBlockerLab</field>
    <description>LAB: reversible persistence-analogue Run key write</description>
    <group>msilblocker_lab,</group>
  </rule>
</group>
